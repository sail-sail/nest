    "decimal.js": "10.6.0",
    "file-saver": "2.0.5",
    "graphql": "16.14.2",
    "swiper": "12.2.0",
    "vue": "3.5.38",
    "vue-router": "5.1.0"
  },
  "devDependencies": {
    "@iconify-json/carbon": "1.2.23",
    "@iconify-json/lucide": "1.2.111",
    "@iconify-json/radix-icons": "1.2.6",
    "@iconify-json/tabler": "1.2.35",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/icon": "2.2.3",
    "@types/file-saver": "2.0.7",
    "@types/node": "25.9.3",
    "@unocss/nuxt": "66.7.2",
    "@unocss/preset-rem-to-px": "66.7.2",
    "@unocss/transformer-directives": "66.7.2",
    "@vue-macros/nuxt": "3.1.2",
    "@vue-macros/reactivity-transform": "3.1.2",
    "nuxt": "4.4.8",
    "sass": "1.101.0",
    "typescript": "6.0.3",
    "unocss": "66.7.2",
    "vue-tsc": "3.3.4"
  },
  "pnpm": {
