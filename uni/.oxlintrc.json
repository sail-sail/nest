{
  "plugins": [
    "oxc",
    "typescript",
    "unicorn",
    "react",
    "vue"
  ],
  "ignorePatterns": [
    "src/typings/**",
    "src/assets/**",
    "src/typings/**",
    "*.d.ts"
  ],
  "rules": {
    "unicorn/no-single-promise-in-promise-methods": "allow",
    "unicorn/no-useless-spread": "allow",
    "@typescript-eslint/no-unused-vars": "allow",
    "@typescript-eslint/no-empty-object-type": "allow",
    "eslint/no-debugger": "allow",
    "no-unused-vars": "allow",
    "no-useless-assignment": "allow",
    "no-debugger": "allow",
    "no-dupe-keys": "allow",
    "vue/no-dupe-keys": "allow",
    "vue/prop-name-casing": "allow",
    "unicorn/no-empty-file": "allow"
  }
}