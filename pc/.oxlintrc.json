{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "oxc",
    "typescript",
    "unicorn",
    "react",
    "vue"
  ],
  "ignorePatterns": [
    "src/typings/**",
    "src/assets/**",
    "*.d.ts"
  ],
  "rules": {
    "unicorn/no-single-promise-in-promise-methods": "allow",
    "unicorn/no-useless-spread": "allow",
    "no-unused-vars": "allow",
    "no-useless-assignment": "allow",
    "no-debugger": "allow",
    "no-dupe-keys": "allow",
    "vue/no-dupe-keys": "allow",
    "vue/prop-name-casing": "allow"
  }
}