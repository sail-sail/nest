{
  "name": "pc",
  "version": "0.0.0",
  "scripts": {
    "start": "vp dev",
    "preview": "set NODE_OPTIONS=--max-old-space-size=4096 && vp preview",
    "test": "vp test",
    "coverage": "vp test run --coverage",
    "build-prod": "set NODE_OPTIONS=--max-old-space-size=4096 && vp build --emptyOutDir && node src/utils/postbuild.js",
    "build-test": "set NODE_OPTIONS=--max-old-space-size=4096 && vp build --mode test --emptyOutDir && node src/utils/postbuild.js",
    "permit": "node src/utils/permit_scan.js",
    "rsw:build": "rsw && npm run build",
    "typecheck": "set NODE_OPTIONS=--max-old-space-size=4096 && vue-tsc --noEmit --skipLibCheck && oxlint .",
    "lint": "oxlint .",
    "lint-staged": "lint-staged",
    "codegen": "cd .. && npm run codegen",
    "sql": "cd ../codegen && node --experimental-strip-types src/util/npmSql.ts",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node src/utils/postinstall.js"
  },
  "dependencies": {
    "@eigenpal/docx-editor-i18n": "1.9.0",
    "@eigenpal/docx-editor-vue": "1.9.0",
    "@element-plus/icons-vue": "2.3.2",
    "@flyfish-group/file-viewer3": "2.1.2",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@opentiny/fluent-editor": "3.25.11",
    "@qr-x/vue": "1.1.1",
    "@vue/reactivity": "3.5.38",
    "@vue/runtime-dom": "3.5.38",
    "@vue/shared": "3.5.38",
    "@vueuse/core": "14.3.0",
    "cronstrue": "3.21.0",
    "danmu": "0.20.0",
    "dayjs": "1.11.21",
    "decimal.js": "10.6.0",
    "docx-handlebars": "0.3.3",
    "echarts": "6.1.0",
    "ejsexcel-browserify": "4.4.3",
    "element-plus": "2.14.2",
    "expr-eval": "2.0.2",
    "file-saver": "2.0.5",
    "filesize": "11.0.17",
    "graphql": "17.0.1",
    "graphql-combine-query": "1.2.4",
    "jszip": "3.10.1",
    "numeral": "2.0.6",
    "pinyin-pro": "3.28.1",
    "sortablejs": "1.15.7",
    "swiper": "12.2.0",
    "vue": "3.5.38",
    "vue-countup-v3": "1.4.2",
    "vue-demi": "0.14.10",
    "vue-router": "5.1.0",
    "xlsx": "jsr:@sail/xlsx@0.20.3",
    "xlsx-handlebars": "0.2.2"
  },
  "devDependencies": {
    "@plugin-web-update-notification/vite": "2.1.2",
    "@types/file-saver": "2.0.7",
    "@types/node": "26.0.0",
    "@types/sortablejs": "1.15.9",
    "@unocss/preset-rem-to-px": "66.7.2",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vue-macros/reactivity-transform": "3.1.2",
    "@vue/compiler-sfc": "3.5.38",
    "@vue/devtools-api": "8.1.3",
    "@vue/runtime-core": "3.5.38",
    "dotenv": "17.4.2",
    "globals": "17.7.0",
    "mysql2": "3.22.5",
    "oxlint": "1.71.0",
    "sass": "1.101.0",
    "spark-md5": "3.0.2",
    "svgo": "4.0.1",
    "typescript": "6.0.3",
    "unocss": "66.7.2",
    "unplugin-auto-import": "21.0.0",
    "unplugin-icons": "23.0.1",
    "unplugin-turbo-console": "2.3.2",
    "unplugin-vue-components": "32.1.0",
    "unplugin-vue-define-options": "3.1.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plugin-devtools-json": "1.0.0",
    "vite-plugin-inspect": "11.4.1",
    "vite-plugin-pwa": "1.3.0",
    "vite-plugin-vue-devtools": "8.1.3",
    "vite-plugin-vue-inspector": "7.0.0",
    "vite-plugin-wasm": "3.6.0",
    "vite-plus": "latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vue-tsc": "3.3.5"
  }
}
