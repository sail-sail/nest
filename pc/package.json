    "@file-viewer/renderer-text": "3.1.2",
    "@file-viewer/vue3": "3.1.2",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@opentiny/fluent-editor": "3.25.12",
    "@qr-x/vue": "1.1.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-fs": "2.5.2",
    "@tauri-apps/plugin-upload": "2.4.1",
    "@vue/reactivity": "3.5.43",
    "@vue/runtime-dom": "3.5.43",
    "@vue/shared": "3.5.43",
    "@vueuse/core": "15.0.0",
    "@wecom/jssdk": "2.4.4",
    "cronstrue": "3.27.0",
    "danmu": "0.20.0",
    "dayjs": "1.11.23",
    "decimal.js": "10.6.0",
