{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^App(.*)": "@/components/App$1/App$1.vue",
      "^Custom(.*)": "@/components/Custom$1/Custom$1.vue",
      "^Dict(.*)": "@/components/Dict$1/Dict$1.vue",
      "^tm-(.*)": "@/uni_modules/tm-ui/components/tm-$1/tm-$1.vue"
    }
  },
  "pages": [<#
    const uniAllTables = allTables.filter((t) => t.opts?.isUniPage);
    const uniPages = [ ];
    for (let i = 0; i < uniAllTables.length; i++) {
      const record = uniAllTables[i];
      let table_name = record.TABLE_NAME;
      const schema = optTables[table_name];
      if (!schema) continue;
      const table_comment = record.TABLE_COMMENT;
      const hasForeignTabs = schema.columns.some((item) => {
        const foreignTabs = item.foreignTabs || [ ];
        return foreignTabs.some((foreignTab) => {
          return !!optTables[foreignTab.mod + "_" + foreignTab.table]?.opts?.isUniPage;
        });
      });
      table_name = table_name.substring(table_name.indexOf("_") + 1);
      uniPages.push({
        path: `pages/${ table_name }/List`,
        title: `${ table_comment }列表`,
        navigationStyle: record.opts?.isUniPage?.navigationStyle,
      });
      uniPages.push({
        path: `pages/${ table_name }/Detail`,
        title: `${ table_comment }详情`,
        navigationStyle: record.opts?.isUniPage?.navigationStyle,
      });
      if (hasForeignTabs) {
        uniPages.push({
          path: `pages/${ table_name }/ForeignTabs`,
          title: `${ table_comment }详情`,
          navigationStyle: record.opts?.isUniPage?.navigationStyle,
        });
      }
    }
    for (let i = 0; i < uniPages.length; i++) {
      const page = uniPages[i];
    #>
    {
      "path": "<#=page.path#>",
      "style": {<#
        if (page.navigationStyle) {
        #>
        "navigationStyle": "<#=page.navigationStyle#>",<#
        }
        #>
        "navigationBarTitleText": "<#=page.title#>"
      }
    }<#
      if (i < uniPages.length - 1) {
    #>,<#
      }
    #><#
    }
    #>
  ],
  "tabBar": {
    "selectedColor": "#3975C6",
    "color": "#808080",
    "backgroundColor": "#fff",
    "list": [
      {
        "text": "首页",
        "iconPath": "/static/tabbar/home.png",
        "selectedIconPath": "/static/tabbar/home-active.png",
        "pagePath": "pages/home/index"
      },
      {
        "text": "我的",
        "iconPath": "/static/tabbar/my.png",
        "selectedIconPath": "/static/tabbar/my-active.png",
        "pagePath": "pages/my/index"
      }
    ]
  },
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "管理系统",
    "navigationBarBackgroundColor": "#F8F8F8",
    "backgroundColor": "#F8F8F8"
  }
}
