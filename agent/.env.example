# 说明：AGENT_HOME 必须作为系统环境变量传入（决定 .env / .dsh 的位置），写在本文件里无效。
# 生产环境由 systemd 或 shell 设置；本地开发不需要。
# 布尔值支持 true/false、1/0、yes/no、on/off（不区分大小写）；数值必须是整数。
# 非法布尔值或数值会让服务拒绝启动，避免拼写错误被静默当成默认值。

# ---- DeepSeek 模型（dsh sdk profile 使用 deepseek-official）----
# 有 DEEPSEEK_API_KEY 时优先走官方，自定义模型配置会被忽略
DEEPSEEK_API_KEY=
DSH_MODEL=deepseek-v4-flash

# ---- 自定义模型（OpenAI 兼容网关，可选）----
# 仅当 DEEPSEEK_API_KEY 为空时启用；三项都填才会生效
# BASE_URL 写到 /v1，不要带 /chat/completions
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
# 可选：路由名（小写+连字符）、显示名、上下文窗口
CUSTOM_LLM_PROVIDER=custom
CUSTOM_LLM_NAME=
CUSTOM_LLM_CONTEXT_WINDOW=131072

# ---- HTTP ----
AGENT_HOST=127.0.0.1
AGENT_PORT=4002
# 浏览器侧同源地址，用于 Origin 校验
AGENT_PUBLIC_ORIGIN=http://localhost:4000

# ---- 后端 ----
APP_MCP_URL=http://localhost:4001/mcp
APP_GRAPHQL_URL=http://localhost:4001/graphql

# ---- 外接 MCP（知识库等，见 mcp.config.json）----
KB_MCP_TOKEN=
# PageAgent 扩展的 MCP 服务用的独立模型 key
PAGE_AGENT_LLM_KEY=

# ---- 工具安全 ----
# 1 = 只允许只读 GraphQL（拒绝 Mutation）；它不限制页面操作
AGENT_TOOL_READONLY=true

# ---- 长期记忆（按用户隔离，存 .dsh/memory.json）----
# false = 关闭 memory_* 工具与首轮自动注入
AGENT_MEMORY=true
# 新会话首轮自动注入的记忆条数
AGENT_MEMORY_DIGEST_LIMIT=10

# ---- 附件暂存（base64 不进模型上下文）----
# 浏览器 POST /agent/api/attachments?name=xxx 直传宿主，拿到 attachmentId；
# 模型只引用 id，oss_upload 由宿主读盘转 base64 发给后端
AGENT_ATTACHMENT=true
# 单个附件上限（字节）
AGENT_ATTACHMENT_MAX_BYTES=10485760
# 每个用户同时暂存的附件数
AGENT_ATTACHMENT_MAX_FILES=5
# 暂存有效期（毫秒）
AGENT_ATTACHMENT_TTL_MS=1800000
# oss_upload 参数里允许内联的 base64 字符上限（≈6KB 文件）
AGENT_INLINE_BASE64_MAX=8192
# 单次工具输出进入模型上下文的 token 预算（宿主传给 dsh 子进程）
AGENT_TOOL_OUTPUT_TOKENS=6000

# ---- 会话句柄生命周期 ----
# 空闲多久释放句柄（毫秒），下一轮由 resumeSession 重建
AGENT_SESSION_TTL_MS=1800000
# 同时驻留的句柄上限，超出按 LRU 淘汰（正在生成的不淘汰）
AGENT_SESSION_MAX=32

# ---- 用量记账 ----
# 按天落盘 .dsh/usage/YYYY-MM-DD.jsonl 的保留天数
AGENT_USAGE_RETENTION_DAYS=30

# ---- 页面操作（PageAgent，浏览器内执行）----
# SSE 心跳：true = 每 15s 发送 ping；默认关闭，避免无必要心跳
AGENT_HEARTBEAT=false
# false = 整体关闭 page_operate / page_status
AGENT_PAGE_OPERATE=true
# 单次页面任务最长等待（毫秒）
AGENT_PAGE_TIMEOUT_MS=180000
# 单次任务默认最大步数（1-40）
AGENT_PAGE_MAX_STEPS=20
# 浏览器里的 PageAgent 通过 /agent/llm 调模型，key 留在服务端
AGENT_LLM_PROXY=true
# 单请求输出上限（max_tokens 封顶，超出会被压到该值）
AGENT_LLM_MAX_TOKENS=8192
# 每用户每日 token 封顶（按响应 usage 记账，超限返回 429）
AGENT_LLM_DAILY_TOKENS=1000000
# 仅用于 /agent/llm 代理；不会透传给 dsh 子进程
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
