# 说明：AGENT_HOME 必须作为系统环境变量传入（决定 .env / .dsh 的位置），写在本文件里无效。
# 生产环境由 systemd 或 shell 设置；本地开发不需要。

# ---- DeepSeek 模型（dsh sdk profile 使用 deepseek-official）----
DEEPSEEK_API_KEY=
DSH_MODEL=deepseek-v4-flash

# ---- HTTP ----
AGENT_HOST=127.0.0.1
AGENT_PORT=4002
# 浏览器侧同源地址，用于 Origin 校验
AGENT_PUBLIC_ORIGIN=http://localhost:4000

# ---- 后端 ----
APP_MCP_URL=http://localhost:4001/mcp
APP_GRAPHQL_URL=http://localhost:4001/graphql

# ---- 外接 MCP（知识库等，见 mcp.config.json）----
KB_MCP_TOKEN=
# PageAgent 扩展的 MCP 服务用的独立模型 key
PAGE_AGENT_LLM_KEY=

# ---- 工具安全 ----
# 1 = 只允许只读 GraphQL（拒绝 Mutation）；它不限制页面操作
AGENT_TOOL_READONLY=true
# 单轮工具调用上限
AGENT_MAX_TOOL_CALLS=24

# ---- 长期记忆（按用户隔离，存 .dsh/memory.json）----
# false = 关闭 memory_* 工具与首轮自动注入
AGENT_MEMORY=true
# 新会话首轮自动注入的记忆条数
AGENT_MEMORY_DIGEST_LIMIT=10

# ---- 页面操作（PageAgent，浏览器内执行）----
# false = 整体关闭 page_operate / page_status
AGENT_PAGE_OPERATE=true
# 单次页面任务最长等待（毫秒）
AGENT_PAGE_TIMEOUT_MS=180000
# 单次任务默认最大步数（1-40）
AGENT_PAGE_MAX_STEPS=20
# 浏览器里的 PageAgent 通过 /agent/llm 调模型，key 留在服务端
AGENT_LLM_PROXY=true
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
