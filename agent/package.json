{
  "name": "agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "build-prod": "node scripts/build.mjs",
    "start:prod": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke:context": "tsx scripts/smoke-context.ts",
    "smoke:sandbox": "tsx scripts/smoke-sandbox.ts",
    "dsh:config": "node ./node_modules/@deepseek-ai/dsh/lib/bin.js --profile sdk --patch ./dsh/patch.yml --dump-config"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.1",
    "@deepseek-ai/dsh-token-meter": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@hono/node-server": "2.1.8",
    "@modelcontextprotocol/sdk": "1.32.2",
    "graphql": "17.1.0",
    "hono": "4.13.18"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
