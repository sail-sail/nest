{
  "name": "rust",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "scripts": {
    "start": "cargo run",
    "gqlgen": "cargo run --bin schema && graphql-codegen --config ./generated/common/script/graphql_codegen_config.ts",
    "typecheck": "cargo clippy",
    "build-prod": "node ./generated/common/script/build.js --env prod",
    "build-test": "node ./generated/common/script/build.js --env test",
    "publish": "node ./generated/common/script/publish.js",
    "codegen": "cd .. && npm run codegen",
    "sql": "cd ../codegen && node --experimental-strip-types src/util/npmSql.ts",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.2.0",
    "@graphql-codegen/typescript": "6.1.0",
    "@graphql-codegen/typescript-operations": "6.1.1",
    "@parcel/watcher": "2.6.0",
    "@types/fs-extra": "11.0.4",
    "@types/minimist": "1.2.5",
    "@types/node": "26.1.1",
    "commander": "15.0.0",
    "dotenv": "17.4.2",
    "fs-extra": "11.3.6",
    "graphql": "17.0.2",
    "minimist": "1.2.8",
    "ssh2-promise": "1.0.3",
    "typescript": "7.0.2"
  }
}
