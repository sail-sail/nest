{
  "name": "deno",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "scripts": {
    "start": "node lib/script/mother.js",
    "gqlgen": "npx graphql-codegen --config ./lib/script/graphql_codegen_config.ts",
    "typecheck": "deno check ./mod.ts && deno lint",
    "lint": "deno lint",
    "lint-staged": "lint-staged",
    "build-prod": "deno run -A ./lib/script/build.ts --target linux --env prod",
    "build-test": "deno run -A ./lib/script/build.ts --target linux --env test",
    "publish": "node lib/script/publish.js",
    "build:win": "deno run -A ./lib/script/build.ts",
    "codegen": "cd .. && npm run codegen",
    "db_gen_crypto_key": "deno run -A ./lib/script/db_gen_crypto_key.ts",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "dayjs": "1.11.23",
    "decimal.js": "10.6.0",
    "graphql": "17.1.0",
    "js-md5": "0.9.2",
    "lru-cache": "11.5.3",
    "mime": "4.1.2",
    "mnemonist": "0.40.8",
    "mysql2": "3.24.6",
    "path-to-regexp": "6.3.0",
    "sharp": "0.35.5",
    "sqlstring": "2.3.3",
    "wechatpay-node-v3": "2.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-operations": "7.0.1",
    "@types/node": "26.6.6",
    "@types/sqlstring": "2.3.2",
    "chokidar": "6.0.0",
    "commander": "15.1.0",
    "dotenv": "18.0.10",
    "ssh2-promise": "1.0.3",
    "typescript": "7.0.2"
  }
}
